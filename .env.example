# Keep secrets in .env.local, never in Git.
POSTGRES_URL=postgres://user:password@localhost:5434/no_nameglish
BETTER_AUTH_URL=http://localhost:3001
# Generate using: openssl rand -base64 32
BETTER_AUTH_SECRET=
DEEPSEEK_API_KEY=
# Optional, for audio transcription only.
GROQ_API_KEY=

# Required only when provisioning the owner / upgrading the database.
OWNER_USERNAME=valdefer
OWNER_NAME=
OWNER_PASSWORD=
